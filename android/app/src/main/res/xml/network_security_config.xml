<?xml version="1.0" encoding="utf-8"?>
<!--
  服务端地址由用户在「设置」里自己填写，通常是局域网里的 http://192.168.x.x:3000，
  Android 9 起默认禁止明文流量，这里放开 http，否则局域网同步会直接连不上。
  公网部署建议换成 https，并把 cleartextTrafficPermitted 改回 false。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
